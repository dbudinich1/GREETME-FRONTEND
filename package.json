{
  "name": "greetme-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:conformity && npm run verify:viral-loop-lock",
    "verify:viral-loop-lock": "node scripts/verify-creditclaim-viral-loop-lock.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:lock": "node scripts/verify-greeting-lock.mjs",
    "validate:conformity": "node scripts/validate-conformity.mjs",
    "test:viewport": "playwright test",
    "test:viewport:headed": "playwright test --headed",
    "precommit:greeting": "npm run verify:lock",
    "section1c": "node scripts/section1c_landscape_gate.js",
    "section1d": "node scripts/section1d_public_gate.js",
    "tripwire:mobile": "node scripts/tripwireMobileGold.cjs",
    "tripwire:desktop": "node scripts/tripwireDesktopGold.cjs",
    "tripwire:all": "node scripts/runViewportTripwires.cjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.9.0",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.562.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.40.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "vite": "^7.2.4"
  }
}
