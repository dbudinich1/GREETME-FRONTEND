# .env.example — non-secret documentation only. Do NOT put secrets here.
#
# Frontend build/runtime (see README):
#   VITE_API_BASE is set per-environment. .env.development now defaults to the
#   SAFE LOCAL backend (http://127.0.0.1:8099). Production build config sets the
#   real host in CI; it is intentionally NOT documented with a value here.
#
# ===========================================================================
# Automated-test & script safety — single shared guard: safety/apiTarget.mjs
# ===========================================================================
# There is NO production default anywhere. A missing or production target fails
# closed before any network call. Three modes:
#
# --- MUTATING (integration specs + seed scripts: create-4-rounds, create-test-jobs) ---
#   Production is ALWAYS rejected. Requires a local/allow-listed target AND opt-in.
# API_BASE=http://127.0.0.1:8099
# ALLOW_ISOLATED_TEST=1
#   Optional single explicit non-production host (never a production host):
# TEST_ALLOWED_API_HOST=staging-api.internal.test
#
# --- READ-ONLY DIAGNOSTIC (detailed-report, viewport-metrics) ---
#   Explicit API_BASE required; GET/HEAD only. Reading PRODUCTION additionally
#   requires the audit opt-in:
# READ_ONLY_PRODUCTION_AUDIT=true
#
# --- PUBLIC PRODUCTION GATE (section1d_public_gate) ---
#   No embedded host; BASE_URL + API_BASE required; GET/HEAD only; no credentials.
# PUBLIC_PRODUCTION_GATE=true
#
# Layout-only Playwright specs (viewport-fit, layoutLock.invariants, etc.) need
# none of the above; they run against the local Vite dev server (BASE_URL).
